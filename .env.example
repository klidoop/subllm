# Default LLM Provider (gemini | openai | deepseek | openrouter | ollama)
SUBLLM_PROVIDER=gemini
SUBLLM_MODEL=gemini-2.5-flash

# API Keys (comma-separated keys supported for automatic rotation)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Custom / Local Endpoint (optional, e.g. http://localhost:11434/v1 for Ollama)
SUBLLM_API_ENDPOINT=

# Subtitle Timing & Layout Constraints (Cinema Mode defaults)
SUBLLM_MAX_CPS=4.5
SUBLLM_MAX_CPL=18
SUBLLM_SCENE_GAP_SEC=3.0
SUBLLM_MERGE_GAP_SEC=0.8
SUBLLM_LINES_PER_BLOCK=15
